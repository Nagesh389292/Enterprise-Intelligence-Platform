# ==============================================================================
# Enterprise Data & ML Intelligence Platform — Environment Configuration Template
# Copy this file to '.env' and populate with local runtime values.
# ==============================================================================

# --- Application Setup ---
PROJECT_NAME="Enterprise Data & ML Intelligence Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# --- Database Configuration (PostgreSQL) ---
POSTGRES_USER=nexacore_admin
POSTGRES_PASSWORD=nexacore_secret_pass
POSTGRES_DB=nexacore_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Storage & Data Lake Tiers ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLE_DIR=./data/sample

# --- PySpark / Distributed Processing ---
SPARK_APP_NAME="NexaCore-EIP-Engine"
SPARK_MASTER="local[*]"
SPARK_DRIVER_MEMORY=4g

# --- dbt Configuration ---
DBT_PROFILES_DIR=./config
DBT_TARGET=dev

# --- MLflow Tracking Server ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME="nexacore-ml-intelligence"
MLFLOW_ARTIFACT_LOCATION=./mlruns

# --- API Service Configuration (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# --- Future AWS Cloud Credentials (Placeholders) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BRONZE_BUCKET=nexacore-bronze-data-lake
AWS_S3_SILVER_BUCKET=nexacore-silver-data-lake
AWS_S3_GOLD_BUCKET=nexacore-gold-data-lake
